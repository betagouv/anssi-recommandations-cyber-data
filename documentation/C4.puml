hide stereotype
title Niveau 3 — Composants : évaluation de MQC (conteneur « API back-office » et commandes)

legend right
  |= Légende |
  |<#15803d><color:#ffffff> Évaluation de MQC </color>|
  |<#4b5563><color:#ffffff> Commun aux deux domaines </color>|
  |<#999999><color:#ffffff> Système externe </color>|
endlegend

Container(front, "Tableau de bord", "Svelte 5 / TypeScript", "Page Évaluation", $tags="commun")
Container(commandes, "Commandes d'évaluation", "evaluateur_mqc.py, evaluateur_reformulation.py", "Enchaînent collecte, évaluation et consignation sans passer par le Service d'évaluation", $tags="eval")
System_Ext(mqc, "MesQuestionsCyber (MQC)", "Chatbot, route /pose_question")
System_Ext(albert, "Albert (DINUM)", "LLM : reformulation et juge")
System_Ext(prompt, "Prompt de reformulation", "Fichier publié dans le dépôt MQC, URL fournie à l'évaluation")
SystemDb_Ext(journal_db, "Base Journal PostgreSQL", "journal_mqc.evenements", $sprite="postgresql")

Container_Boundary(api, "API back-office") {
    Component(routeur, "Routeur Évaluation", "api/api_evaluation.py", "POST /api/evaluation (CSV de vérité terrain + mapping, tâche de fond) et POST /api/evaluation/reformulation (CSV + URL du prompt)", $tags="eval")
    Component(service, "Service d'évaluation", "evaluation/service_evaluation.py", "Orchestre : collecte des réponses, évaluation, consignation ; lance aussi l'évaluation de la reformulation", $tags="eval")

    Component(collecteur, "Collecteur de réponses", "evaluation/mqc/collecte_reponses_mqc.py, remplisseur_reponses.py", "Lit le CSV par lots, pose les questions en parallèle, écrit un CSV enrichi (réponse, contexte, noms de documents, numéros de page)", $tags="eval")
    Component(client_mqc, "Client MQC", "evaluation/mqc/remplisseur_reponses.py", "ClientMQCHTTPAsync : POST /pose_question", $tags="eval")

    Component(lanceur, "Lanceur DeepEval", "evaluation/mqc/lanceur_deepeval.py", "Joint le CSV au mapping des noms de guides, crée les cas de test, calcule les métriques : hallucination, pertinence de la réponse, toxicité, longueur, bon nom de document et bon numéro de page dans le contexte", $tags="eval")
    Component(multiprocessus, "Évaluateur DeepEval multi-processus", "infra/evaluation/evaluateur_deepeval_multi_processus.py", "Répartit les cas de test sur N processus", $tags="eval")
    Component(juge, "Client juge Albert", "evaluation/mqc/client_deepeval_albert.py", "LLM juge des métriques DeepEval : POST /chat/completions, réponse JSON stricte", $tags="eval")
    Component(entrepot, "Entrepôt d'évaluation", "journalisation/evaluation.py", "Conserve en mémoire les scores par question le temps du traitement", $tags="eval")
    Component(consignateur, "Consignateur d'évaluation", "journalisation/consignateur_evaluation.py", "Rapproche chaque score de sa ligne du CSV et consigne un événement EVALUATION_CALCULEE par question", $tags="eval")

    Component(evaluateur_reformulation, "Évaluateur de reformulation", "evaluation/reformulation/evaluation.py", "Reformule chaque question avec le prompt, puis mesure : suppression des parasites, conservation des contraintes, autoportance, fidélité métier", $tags="eval")
    Component(client_reformulation, "Client Albert de reformulation", "adaptateurs/client_albert_reformulation_reel.py", "Appelle le modèle de reformulation d'Albert", $tags="eval")
    Component(bus, "Bus d'événements", "evenement/bus.py", "En processus, synchrone", $tags="commun")
    Component(consommateur, "Consommateur de journalisation", "evaluation/reformulation/evenements/journal.py", "Abonné à EVALUATION_REFORMULATION_TERMINEE", $tags="eval")
    Component(adaptateur_journal, "Adaptateur journal", "adaptateurs/journal.py", "Postgres si DB_HOST est défini, sinon mémoire", $tags="commun")
}

Rel(front, routeur, "Envoie la vérité terrain et le mapping, ou le CSV de reformulation", "multipart, HTTPS")
Rel(routeur, service, "Lance l'évaluation")
Rel(routeur, prompt, "Télécharge le prompt à évaluer", "HTTPS")

Rel(service, collecteur, "1. Collecte les réponses")
Rel(collecteur, client_mqc, "Pose chaque question")
Rel(client_mqc, mqc, "POST /pose_question", "HTTPS")
Rel(service, lanceur, "2. Évalue le CSV de réponses")
Rel(lanceur, multiprocessus, "Répartit les cas de test")
Rel(lanceur, juge, "Fournit le LLM juge aux métriques")
Rel(lanceur, entrepot, "Persiste les scores")
Rel(juge, albert, "POST /chat/completions", "HTTPS")
Rel(service, consignateur, "3. Consigne les résultats")
Rel(consignateur, entrepot, "Relit les scores")
Rel(consignateur, adaptateur_journal, "EVALUATION_CALCULEE")

Rel(commandes, collecteur, "1. Collecte")
Rel(commandes, lanceur, "2. Évalue")
Rel(commandes, consignateur, "3. Consigne")

Rel(service, evaluateur_reformulation, "Évalue la reformulation")
Rel(evaluateur_reformulation, client_reformulation, "Reformule la question")
Rel(evaluateur_reformulation, multiprocessus, "Évalue les cas de test")
Rel(client_reformulation, albert, "Modèle de reformulation", "HTTPS")
Rel(evaluateur_reformulation, bus, "Publie EVALUATION_REFORMULATION_TERMINEE")
Rel(bus, consommateur, "Notifie")
Rel(consommateur, adaptateur_journal, "Enregistre")

Rel(adaptateur_journal, journal_db, "INSERT", "SQL")
@enduml


