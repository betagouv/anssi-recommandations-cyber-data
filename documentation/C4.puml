@startuml C4-3-Composants-Evaluation
!include <C4/C4_Component>
!include <logos/postgresql>

AddElementTag("eval", $bgColor="#15803d", $fontColor="#ffffff", $borderColor="#14532d", $legendText="Évaluation de MQC")

