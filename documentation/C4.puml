AddRelTag("flux_collections", $textColor="#c2410c", $lineColor="#c2410c", $lineStyle=DashedLine(), $legendText="Flux de gestion des collections")

AddElementTag("commun", $bgColor="#4b5563", $fontColor="#ffffff", $borderColor="#1f2937", $legendText="Commun aux deux domaines")

